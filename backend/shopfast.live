# Fixed Nginx Configuration for shopfast.live
# Copy this to /etc/nginx/sites-available/shopfast.live

# =====================================================
# 🌍 HTTP Redirect Server (Port 80)
# =====================================================
server {
    listen 80;
    listen [::]:80;
    server_name shopfast.live www.shopfast.live;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }

    access_log /var/log/nginx/shopfast-http.access.log;
    error_log /var/log/nginx/shopfast-http.error.log;
}

# =====================================================
# 🚀 Main HTTPS Server Block (ShopFast Production)
# =====================================================
server {
    listen 443 ssl;
    listen [::]:443 ssl ipv6only=on;
    server_name shopfast.live;

    root /var/www/shopfast.live;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/shopfast.live/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shopfast.live/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml font/woff2 font/woff;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # =====================================================
    # 🧠 Backend API Proxy (Spring Boot) - Using regex matching
    # =====================================================

    # Admin Service - API (must be before more specific routes)
    location ~ ^/api/v1/admin(/.*)?$ {
        proxy_pass http://127.0.0.1:8093$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # Product Service - API
    location ~ ^/api/v1/product(/.*)?$ {
        proxy_pass http://127.0.0.1:8081$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # Category Service - API
    location ~ ^/api/v1/category(/.*)?$ {
        proxy_pass http://127.0.0.1:8082$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # Inventory Service - API
    location ~ ^/api/v1/inventory(/.*)?$ {
        proxy_pass http://127.0.0.1:8083$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # Order Service - API
    location ~ ^/api/v1/order(/.*)?$ {
        proxy_pass http://127.0.0.1:8084$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # User Service - API
    location ~ ^/api/v1/user(/.*)?$ {
        proxy_pass http://127.0.0.1:8086$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # Auth Service - API
    location ~ ^/api/v1/auth(/.*)?$ {
        proxy_pass http://127.0.0.1:8087$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # Cart Service - API
    location ~ ^/api/v1/cart(/.*)?$ {
        proxy_pass http://127.0.0.1:8088$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # Notification Service - API
    location ~ ^/api/v1/notification(/.*)?$ {
        proxy_pass http://127.0.0.1:8091$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # Coupon Service - API
    location ~ ^/api/v1/coupon(/.*)?$ {
        proxy_pass http://127.0.0.1:8092$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # Eureka Dashboard
    location ~ ^/eureka(/.*)?$ {
        proxy_pass http://127.0.0.1:8761$1;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_connect_timeout 60s;
    }

    # Elasticsearch
    location /elasticsearch/ {
        proxy_pass http://localhost:9200/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # =====================================================
    # 🌐 Angular Frontend SPA Fallback (must be last)
    # =====================================================
    location / {
        try_files $uri $uri/ /index.html;
    }

    # =====================================================
    # 📊 Logging
    # =====================================================
    access_log /var/log/nginx/shopfast.access.log;
    error_log /var/log/nginx/shopfast.error.log;
}
