# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#   ./generate-secrets.sh >> .env      # or fill in manually
#
# docker-compose.yml refuses to start if any of these are missing, so there is no
# way to accidentally deploy with a default.

# Postgres superuser password. Used by the postgres container AND every service.
# If you change this on an existing deployment, the existing database volume keeps
# the OLD password - see the runbook before rotating.
DB_PASSWORD=

# HMAC signing key for JWTs. Must be identical across all services or tokens issued
# by auth-service will be rejected everywhere else.
# Generate: openssl rand -base64 48
JWT_SECRET=

# AES key for encrypting stored passwords in auth-service. Base64, 32 bytes.
# WARNING: changing this makes all existing stored passwords undecryptable.
# Generate: openssl rand -base64 32
APP_PASSWORD_ENCRYPTION_KEY=
