# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#   ./generate-secrets.sh >> .env      # or fill in manually
#
# docker-compose.yml refuses to start if any of these are missing, so there is no
# way to accidentally deploy with a default.

# Postgres superuser password. Used by the postgres container AND every service.
# If you change this on an existing deployment, the existing database volume keeps
# the OLD password - see the runbook before rotating.
DB_PASSWORD=

# HMAC signing key for JWTs. Must be identical across all services or tokens issued
# by auth-service will be rejected everywhere else.
# Generate: openssl rand -base64 48
JWT_SECRET=

# AES key for encrypting stored passwords in auth-service. Base64, 32 bytes.
# WARNING: changing this makes all existing stored passwords undecryptable.
# Generate: openssl rand -base64 32
APP_PASSWORD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Keycloak (OIDC identity provider)
# ---------------------------------------------------------------------------
# Bootstrap admin for the Keycloak master realm. Only used to create the very
# first admin account; create a named admin and disable this one in production.
KEYCLOAK_ADMIN=admin
# Generate: openssl rand -base64 32
KEYCLOAK_ADMIN_PASSWORD=

# Issuer URI that appears in the `iss` claim of every token. Must be reachable
# by BOTH the services (for JWKS) and the browser (for the login redirect), so
# in production this is the public HTTPS URL, not the container hostname.
KEYCLOAK_ISSUER_URI=http://keycloak:8180/realms/shopfast

# Confidential client secret used for service-to-service (client_credentials)
# tokens. Generate: openssl rand -base64 32
SHOPFAST_SERVICES_CLIENT_SECRET=

# Confidential client secret for the admin console frontend.
# Generate: openssl rand -base64 32
SHOPFAST_ADMIN_CLIENT_SECRET=
