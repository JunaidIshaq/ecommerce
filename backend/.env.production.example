# Production Environment Variables
# Copy this file to .env.production and update the values

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Legacy JWT Secret. Still required during the Keycloak migration window because the
# gateway accepts old HS256 tokens until they expire. Once the LegacyTokensStillInUse
# alert has been silent for longer than the refresh-token lifetime, delete this line:
# unsetting it is the kill switch that makes the gateway reject all legacy tokens.
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_for_security

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
# Public base URL of Keycloak. This value is baked into the `iss` claim of every
# token, so it must be the URL clients actually reach - not an internal hostname.
# Changing it later invalidates every token in circulation.
KEYCLOAK_PUBLIC_URL=https://auth.yourdomain.com

# Must be KEYCLOAK_PUBLIC_URL + /realms/shopfast. Services fetch JWKS from here and
# reject any token whose `iss` differs, so a mismatch shows up as a blanket 401.
KEYCLOAK_ISSUER_URI=https://auth.yourdomain.com/realms/shopfast

# Bootstrap admin account. Create a named admin user in the console after first
# login, then remove these two lines and restart - a static root admin in the
# environment is a standing risk.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_immediately_after_first_login

# Shared confidential-client secret used for service-to-service (client_credentials)
# tokens and by auth-service for Admin REST calls. Generate with: openssl rand -hex 32
SHOPFAST_SERVICES_CLIENT_SECRET=generate_with_openssl_rand_hex_32

# Application Ports (optional - defaults are set in docker-compose)
# API Gateway runs on ports 80 and 443

# Optional: Domain name (for SSL configuration)
# DOMAIN_NAME=yourdomain.com

# Optional: Email configuration for notifications
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password

# Optional: Logstash (if using centralized logging)
# LOGSTASH_HOST=logstash
# LOGSTASH_PORT=5000
